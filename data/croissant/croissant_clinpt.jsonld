        {
          "@type": "cr:Field",
          "@id": "ner-examples/tags",
          "name": "tags",
          "description": "Anotações de entidades nomeadas por categoria.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "task"
            },
            "transform": {
              "replace": "*/Please refer to the 'tags' field in the original dataset."
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ner-examples/task",
