    {
      "@type": "cr:RecordSet",
      "@id": "ner-examples",
      "name": "ner-examples",
      "description": "Reconhecimento de entidades clínicas em prontuários SemClinBr (completo).",
      "key": {
        "@id": "id"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "ner-examples/id",
          "name": "id",
          "description": "Identificador único",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "ner-examples/text",
          "name": "text",
          "description": "Texto da anotação clínica",
