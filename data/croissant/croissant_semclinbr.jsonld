          "name": "tags",
          "description": "Entidades clínicas anotadas.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "task"
            },
            "transform": {
              "replace": "*/Please refer to the 'tags' field in the original dataset."
            }
          }
        },
        {
