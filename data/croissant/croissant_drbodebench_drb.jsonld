  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "multiple-choice-examples",
      "name": "multiple-choice-examples",
      "description": "Questões de múltipla escolha para exames médicos (completo).",
      "key": {
        "@id": "id"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-examples/id",
          "name": "id",
          "description": "Identificador único da questão",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-examples/origem",
