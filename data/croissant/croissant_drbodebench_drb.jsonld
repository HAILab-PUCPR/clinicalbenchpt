            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "origem"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-examples/prova",
          "name": "prova",
          "description": "Ano da prova",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "prova"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-examples/numero",
          "name": "numero",
          "description": "Número da questão na prova",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "numero"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-examples/enunciado",
          "name": "enunciado",
          "description": "Enunciado da questão",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "enunciado"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-examples/alternativas",
          "name": "alternativas",
          "description": "Dicionário de alternativas de múltipla escolha.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "task"
            },
            "transform": {
              "replace": "*/Please refer to the 'alternativas' field in the original dataset."
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-examples/resposta",
          "name": "resposta",
          "description": "Alternativa correta (gabarito)",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "resposta"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "multiple-choice-examples/contains_img",
          "name": "contains_img",
          "description": "Se a questão contém imagem associada",
          "dataType": "sc:Boolean",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "contains_img"
            }
