    {
      "@type": "cr:RecordSet",
      "@id": "questions",
      "name": "questions",
      "description": "Perguntas e respostas sobre medicamentos (completo).",
      "key": {
        "@id": "id"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "questions/id",
          "name": "id",
          "description": "Identificador único",
          "dataType": "sc:Integer",
