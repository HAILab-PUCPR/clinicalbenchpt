      "description": "Split 'train' com 7405 registros.",
      "sha256": "3ca0fd6570ec4d402a899de48caa9216165338411da22fb753a79a2f3147012d"
    },
    {
      "@type": "cr:FileObject",
      "@id": "dev.jsonl",
      "name": "dev.jsonl",
      "contentUrl": "../benchmark/wikidoc_pt/dev.jsonl",
      "encodingFormat": "application/jsonlines",
      "description": "Split 'dev' com 926 registros.",
