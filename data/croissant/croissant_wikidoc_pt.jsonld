  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "questions",
      "name": "questions",
      "description": "Perguntas e respostas médicas da WikiDoc em português (completo).",
      "key": {
        "@id": "id"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "questions/id",
          "name": "id",
          "description": "Identificador único",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/question",
          "name": "question",
          "description": "Pergunta sobre condição médica",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "question"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/answer",
          "name": "answer",
          "description": "Explicação e fisiopatologia de referência",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "questions/task",
          "name": "task",
          "description": "Tipo de tarefa (qa).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "full.jsonl"
            },
            "extract": {
              "column": "task"
            }
          }
        }
      ]
